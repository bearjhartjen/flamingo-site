#!/bin/sh
# pre-commit — rebuild the site and stage the result so a single commit
# carries both the edited data and the regenerated site. Safe to run from
# any directory and quiet when there is nothing to do. (The builder already
# rebuilds and stages on every Save; this is the safety net for anything
# changed by hand.)
#
# Notes on the shell:
#   * `set -e` aborts on any unhandled failure. Calls whose non-zero exit is
#     meaningful here (the build) are guarded with `if`/`||` so they never
#     abort the script.
set -e

ROOT=$(git rev-parse --show-toplevel) || {
  printf 'pre-commit: not inside a git repository.\n' >&2
  exit 1
}

BUILD="$ROOT/scripts/build.py"
SITE="$ROOT/site"
DATA="$ROOT/data"

# 0. Sync the ledger. The authoritative copy lives on the Desktop, outside
#    the repo, and is the only plaintext copy. The sync replaces every
#    private note with its encrypted token, so the repo copy never holds
#    private note text. A failed sync aborts the commit -- it must never
#    fall back to copying plaintext.
SRC="$HOME/Desktop/The Flank.md"
ENC="$ROOT/scripts/encrypt_flank.py"
if [ -f "$SRC" ]; then
  if [ -f "$ENC" ]; then
    if ! out=$(python3 "$ENC" 2>&1); then
      printf '%s\n' "$out" >&2
      printf 'pre-commit: ledger encryption FAILED. Commit aborted -- the repo copy must never hold plaintext notes.\n' >&2
      printf 'pre-commit: (is the passphrase keyfile present? see scripts/flank_crypto.py)\n' >&2
      exit 1
    fi
    printf 'pre-commit: ledger synced with private notes encrypted\n'
  else
    printf 'pre-commit: scripts/encrypt_flank.py missing; skipping ledger sync.\n' >&2
  fi
else
  printf 'pre-commit: "%s" not found; skipping ledger sync.\n' "$SRC"
fi

# 1. Rebuild the site (main pages plus site/flank/). A failed build aborts
#    never published. (A missing build.py is a setup gap, not a build error,
#    so it is reported and skipped rather than failing every commit.)
if [ -f "$BUILD" ]; then
  if ! out=$(python3 "$BUILD" 2>&1); then
    printf '%s\n' "$out" >&2
    printf 'pre-commit: site build FAILED. Commit aborted.\n' >&2
    printf 'pre-commit: bypass with: git commit --no-verify\n' >&2
    exit 1
  fi
else
  printf 'pre-commit: scripts/build.py not found; skipping site build.\n'
fi

# 2. Stage the data and the regenerated site.
if [ -d "$DATA" ]; then
  git add -- data
fi
if [ -d "$SITE" ]; then
  git add -- site
fi
if [ -f "$ROOT/assets/logo.png" ]; then
  git add -- assets/logo.png
fi
if [ -f "$ROOT/assets/favicon.png" ]; then
  git add -- assets/favicon.png
fi
if [ -f "$ROOT/assets/apple-touch-icon.png" ]; then
  git add -- assets/apple-touch-icon.png
fi
# The Financials dashboard needs these two source files in every checkout:
# the vendored chart runtime and the generator that writes the chart data.
if [ -f "$ROOT/assets/chart.umd.min.js" ]; then
  git add -- assets/chart.umd.min.js
fi
if [ -f "$ROOT/scripts/page_extras.py" ]; then
  git add -- scripts/page_extras.py
fi

exit 0
